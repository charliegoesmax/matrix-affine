# =============================================================================
# Super Collab — Environment Configuration
# Copy this file to .env and edit the values before first run.
# =============================================================================

# -----------------------------------------------------------------------------
# Continuwuity (Matrix homeserver)
# IMPORTANT: CONTINUWUITY_SERVER_NAME cannot be changed later without wiping data.
# For pure local testing use "localhost".
# -----------------------------------------------------------------------------
CONTINUWUITY_SERVER_NAME=NameHere
CONTINUWUITY_PORT=6167

# Generate a long random token (example):
#   openssl rand -hex 32
CONTINUWUITY_REGISTRATION_TOKEN=TokenHere

# -----------------------------------------------------------------------------
# Element Web client
# -----------------------------------------------------------------------------
ELEMENT_PORT=8080
# Element / Matrix recovery key (keep private — anyone with this can read your encrypted history)
ELEMENT_RECOVERY_KEY=KeyHere

# -----------------------------------------------------------------------------
# BookStack
# Generate APP_KEY with:
#   docker run -it --rm --entrypoint /bin/bash lscr.io/linuxserver/bookstack:latest appkey
# -----------------------------------------------------------------------------
BOOKSTACK_PORT=6875
BOOKSTACK_APP_KEY=base64:KeyHere
BOOKSTACK_DB_USERNAME=UserHere
BOOKSTACK_DB_PASSWORD=PasswordHere
BOOKSTACK_DB_ROOT_PASSWORD=PasswordHere
APP_THEME=custom #Optional

# -----------------------------------------------------------------------------
# AFFiNE (infinite canvas) — managed by idle watcher
# The watcher listens on AFFINE_PORT and starts/stops the AFFiNE stack.
# After AFFINE_IDLE_SECONDS of no traffic it stops the containers.
# -----------------------------------------------------------------------------
AFFINE_PORT=3010
AFFINE_IDLE_SECONDS=900
AFFINE_DB_USER=UserHere
AFFINE_DB_PASSWORD=PasswordHere
AFFINE_DB_NAME=DbNameHere

# Timezone (optional)
TZ=EST
