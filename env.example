# =============================================================================
# Super Collab — Environment Configuration
# Copy this file to .env and edit the values before first run.
# =============================================================================

# -----------------------------------------------------------------------------
# Continuwuity (Matrix homeserver)
# IMPORTANT: CONTINUWUITY_SERVER_NAME cannot be changed later without wiping data.
# For pure local testing use "localhost". For a real domain later, set it correctly from the start.
# -----------------------------------------------------------------------------
CONTINUWUITY_SERVER_NAME=localhost
CONTINUWUITY_PORT=6167

# Generate a long random token (example command):
#   openssl rand -hex 32
CONTINUWUITY_REGISTRATION_TOKEN=changeme-to-a-long-random-string

# -----------------------------------------------------------------------------
# Element Web client
# -----------------------------------------------------------------------------
ELEMENT_PORT=8080

# -----------------------------------------------------------------------------
# AFFiNE
# -----------------------------------------------------------------------------
AFFINE_PORT=3010

# Strong password for the AFFiNE Postgres database
POSTGRES_PASSWORD=changeme-strong-password-here

# -----------------------------------------------------------------------------
# Optional Meilisearch (only used with: docker compose --profile search up -d)
# -----------------------------------------------------------------------------
MEILI_PORT=7700
MEILI_MASTER_KEY=changeme-meili-master-key
